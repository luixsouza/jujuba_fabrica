# ==========================================
# JUJUBA FABRICA - CONFIGURACAO DE AMBIENTE
# ==========================================
# Copie este arquivo para .env e configure os valores

# ==========================================
# BANCO DE DADOS (MySQL)
# ==========================================
MYSQL_ROOT_PASSWORD=sua_senha_root_segura_aqui
MYSQL_DATABASE=jujuba_brecho
MYSQL_USER=jujuba_user
MYSQL_PASSWORD=sua_senha_segura_aqui
MYSQL_PORT=3306

# ==========================================
# BACKEND (Spring Boot)
# ==========================================
BACKEND_PORT=8080

# JWT - IMPORTANTE: Gere uma chave segura com pelo menos 32 caracteres
# Exemplo: openssl rand -base64 32
JWT_SECRET=sua_chave_jwt_super_secreta_com_pelo_menos_32_caracteres
JWT_EXPIRE_HOURS=2

# CORS - URLs permitidas (separadas por virgula para multiplas)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://seu-dominio.com

# Swagger - Desabilitar em producao
SWAGGER_ENABLED=false

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ==========================================
# FRONTEND (Next.js)
# ==========================================
FRONTEND_PORT=3000

# URL da API (usada no build do frontend)
# Em producao, use a URL publica do backend
NEXT_PUBLIC_API_URL=http://localhost:8080

# ==========================================
# PRODUCAO (Nginx)
# ==========================================
# Descomente e configure para usar HTTPS
# DOMAIN=seu-dominio.com
# SSL_CERTIFICATE=/etc/nginx/ssl/fullchain.pem
# SSL_CERTIFICATE_KEY=/etc/nginx/ssl/privkey.pem
